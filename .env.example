# 复制为 .env 并填入真实值（.env 已被 gitignore，绝不入库）
# Oracle 连接（docker-compose env_file 注入 cube 容器）
CUBEJS_DB_HOST=
CUBEJS_DB_PORT=
CUBEJS_DB_NAME=
CUBEJS_DB_USER=
CUBEJS_DB_PASS=
CUBEJS_DB_TYPE=oracle

# Cube API 鉴权（固定 secret，env_file 注入容器，agent/cube.js 同容器内直接读 env）
CUBEJS_DEV_MODE=true
CUBEJS_API_SECRET=

# LLM 通道（chat 桥调用）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
