  {
    "name": "B1-1 meta 透出（treasury）",
    "type": "meta",
    "layer": "meta 接缝",
    "endpoint": "GET /agent/meta/fiscal_treasury_view",
    "expect": {
      "containsMeasures": [
        "amt_yoy_diff", "amt_yoy_rate", "count_yoy_diff", "count_yoy_rate",
        "amt_mom_diff", "amt_mom_rate", "count_mom_diff", "count_mom_rate",
        "amt_qoq_diff", "amt_qoq_rate", "count_qoq_diff", "count_qoq_rate"
      ],
      "notContainsMeasures": ["amt_ly", "count_ly", "amt_lm", "amt_lq", "count_lm", "count_lq"]
    }
  },
  {
    "name": "B1-2 treasury build_date 年同比数值闭环",
    "type": "query",
    "layer": "数值闭环",
    "query": {
      "measures": [
        "fiscal_treasury_view.amt",
        "fiscal_treasury_view.amt_yoy_diff",
        "fiscal_treasury_view.amt_yoy_rate",
        "fiscal_treasury_view.count",
        "fiscal_treasury_view.count_yoy_diff",
        "fiscal_treasury_view.count_yoy_rate"
      ],
      "timeDimensions": [
        {
          "dimension": "fiscal_treasury_view.build_date",
          "granularity": "year",
          "dateRange": ["2022-01-01", "2024-12-31"]
        }
      ],
      "order": { "fiscal_treasury_view.build_date": "asc" }
    },
    "renewQuery": true,
    "expect": {
      "rowKey": "year",
      "rows": {
        "2022": { "amt": "46053.04", "count": "34", "amt_yoy_diff": null, "amt_yoy_rate": null, "count_yoy_diff": null, "count_yoy_rate": null },
        "2023": { "amt": "34178.26", "count": "10", "amt_yoy_diff": "-11874.78", "amt_yoy_rate": "-25.785", "count_yoy_diff": "-24", "count_yoy_rate": "-70.588" },
        "2024": { "amt": "3463.30", "count": "15", "amt_yoy_diff": "-30714.96", "amt_yoy_rate": "-89.867", "count_yoy_diff": "5", "count_yoy_rate": "50" }
      },
      "note": "diff=本期−上年同期精确相等；rate=diff÷上年×100 按三位小数近似比对（count_yoy_rate 批 4 补：−24/34=−70.588、5/10=50）；2022 无上年行为 null 非 0。2026 行(29372234.54/17)为时点值会漂，不设锚，仅查 diff=null。"
    }
  },
